{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9844c4cb167343fe952a578e10b72ebd",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ScreenAlignedPixelUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1050.0,
            "y": 300.0,
            "width": 268.0,
            "height": 262.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "71f9927a59f846888cf6ccef59fbc50f"
        },
        {
            "m_Id": "3b95dbee9d334b7babcf1319a06940a6"
        },
        {
            "m_Id": "576585a412a7428ba4753e0776ea8891"
        },
        {
            "m_Id": "9f846b0786c34ebebb80fcf25a9d1ff0"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ScreenAlignedPixelUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Convert the screen-cell offset back to the original texture UV.\n// Inverting the screen derivatives also handles render-target Y orientation.\nfloat size = max(round(PixelSize), 1.0);\nfloat2 p = ScreenUV * _ScreenParams.xy;\nfloat2 delta = (floor(p / size) + 0.5) * size - p;\nfloat2 sx = ddx(p);\nfloat2 sy = ddy(p);\nfloat determinant = sx.x * sy.y - sx.y * sy.x;\nfloat safeDet = abs(determinant) > 1e-8 ? determinant : 1.0;\nfloat2 offset = float2(delta.x * sy.y - delta.y * sy.x,\n                      sx.x * delta.y - sx.y * delta.x) / safeDet;\nfloat2 corrected = UV + ddx(UV) * offset.x + ddy(UV) * offset.y;\nOut = (abs(determinant) > 1e-8 && size > 1.0) ? corrected : UV;"
}

